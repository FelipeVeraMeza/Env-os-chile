# ============================================================================
#  VARIABLES PARA RAILWAY (base de datos y archivos en SUPABASE)
#  Railway → tu servicio → Variables → "Raw Editor" → pega esto con tus valores.
#  Guía completa: docs/12-primera-version-railway-supabase.md
#  ⚠ NO subas este archivo con valores reales al repositorio.
# ============================================================================

NODE_ENV=production
TZ=America/Santiago

# BASE DE DATOS — opción fácil: con estos dos datos el servidor encuentra solo el "Session pooler".
# (La contraseña puede tener símbolos como @; no hay que codificarla).
SUPABASE_DB_PASSWORD=LA_CLAVE_DE_LA_BASE
# Opción manual (en vez de la anterior): Supabase → Connect → Session pooler → URI (puerto 5432)
# DATABASE_URL=postgresql://postgres.TU_REF:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://TU_REF.supabase.co
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…)  o la antigua "service_role"
SUPABASE_SECRET_KEY=sb_secret_CAMBIAR
# Bucket privado para fotos y boletas (se crea solo en el primer arranque)
SUPABASE_BUCKET=envios-privado

# Cadena aleatoria de 64 caracteres: npm run secreto
JWT_SECRET=CAMBIAR_POR_UNA_CADENA_LARGA_ALEATORIA

# Administrador inicial: SOLO para el primer arranque con la base vacía. Las cuentas quedan en la base
# (contraseña cifrada); después del primer arranque BORRA estas dos variables. También se puede crear con
# npm run reiniciar -- --correo … --clave … --confirmar (ver docs/16-inicio-de-sesion.md).
# ADMIN_EMAIL=admin@tuempresa.cl
# ADMIN_PASSWORD=CAMBIAR.Clave.Segura

# INICIO DE SESIÓN REAL (recomendado para operar): cada persona entra con su correo y contraseña.
# Las cuentas demo (@demo.cl) quedan sin acceso al arrancar; el administrador crea los usuarios reales.
AUTH_MODE=jwt
SEED_DEMO=false

# Alternativa solo para mostrar el visual con datos de prueba (se entra eligiendo un perfil, sin contraseña).
# DEMO_CLAVE es opcional: si la defines, se pide una sola vez para entrar a la demo.
# AUTH_MODE=demo
# SEED_DEMO=true
# DEMO_CLAVE=

# Conexiones a la base por servidor (Supabase gratis: 5; con plan pagado se puede subir a 10-15)
# DB_POOL_MAX=5
# Límite de solicitudes por minuto y por IP (0 = sin límite)
# LIMITE_API_POR_MINUTO=1200
# LIMITE_PUBLICO_POR_MINUTO=60

# Correo para recuperar contraseñas (opcional). Sin esto, administración genera el enlace y lo comparte.
# SMTP_URL=smtps://usuario:clave@smtp.tu-proveedor.cl:465
# SMTP_FROM=Envíos <no-responder@tuempresa.cl>

# Opcionales
# SEGURIDAD_WEBHOOK_URL=https://hooks.slack.com/...   (aviso inmediato de alertas críticas en Slack/Discord/Google Chat)
# PUBLIC_BASE_URL=https://envios.tuempresa.cl   (si no se define, usa el dominio de Railway)
# CORS_ORIGINS=https://tu-app.vercel.app        (solo si la interfaz se publica en Vercel)
