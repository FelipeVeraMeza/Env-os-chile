# ============================================================================
#  ARCHIVO DE ENTORNOS — Plataforma de Gestión de Envíos
#  Aquí pegas las URLs de cada ambiente. Lo usan:
#    · las pruebas QA   → npm run qa:local | npm run qa:railway | npm run qa:vercel
#    · la interfaz web  → npm run build:web (genera web/config.js)
#  No pongas contraseñas reales en este archivo: se sube al repositorio.
#  Si necesitas credenciales, créalas en "entornos.local.env" (está en .gitignore).
# ============================================================================

# Backend + interfaz corriendo en tu computador (npm run dev)
URL_LOCAL=http://localhost:3000

# Servicio en Railway (Settings → Networking → Public domain). Ej: https://envios-production.up.railway.app
URL_RAILWAY=https://www.jfenvios.cl

# Interfaz publicada en Vercel (opcional). Ej: https://envios.vercel.app
URL_VERCEL=https://CAMBIAR-POR-TU-APP.vercel.app

# Dominio definitivo registrado en NIC.cl (cuando exista). Ej: https://envios.tuempresa.cl
URL_PRODUCCION=

# Ambiente por defecto para "npm run qa": local | railway | vercel | produccion
QA_OBJETIVO=local

# API a la que se conecta la interfaz al generar web/config.js: local | railway | produccion | mismo_origen
API_OBJETIVO=mismo_origen

# Solo si el backend corre con AUTH_MODE=jwt (inicio de sesión real): usuario admin para QA.
# Definir en entornos.local.env, NO aquí.
# QA_ADMIN_CORREO=
# QA_ADMIN_PASSWORD=
# Si la demo publicada tiene DEMO_CLAVE, pon la misma clave en entornos.local.env:
# QA_DEMO_CLAVE=
