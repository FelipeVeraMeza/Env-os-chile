{
  "name": "plataforma-gestion-envios",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de Gestión de Envíos (Chile) — base técnica v0.1 + documentación de alcance y QA",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:migrate": "node server/db/migrate.js",
    "test": "npm run test:unit",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "qa": "node qa/run.js",
    "qa:local": "node qa/run.js local",
    "qa:railway": "node qa/run.js railway",
    "qa:vercel": "node qa/run.js vercel",
    "build:web": "node scripts/build-web-config.js",
    "verificar": "node scripts/verificar-despliegue.js",
    "verificar:railway": "node scripts/verificar-despliegue.js --railway",
    "datos-demo": "node scripts/datos-demo.js",
    "secreto": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "sql:supabase": "node scripts/generar-sql-supabase.js",
    "publicar": "node scripts/publicar.js",
    "reiniciar": "node scripts/reiniciar-datos.js",
    "borrar-envios": "node scripts/borrar-envios.js",
    "manual": "node scripts/manual/generar-manual.mjs",
    "carga": "node scripts/prueba-carga.js",
    "e2e": "node qa/e2e/flujo-completo.js",
    "interfaz": "node qa/e2e/correcciones-interfaz.js",
    "verificar:casos": "node qa/verificar-casos.js",
    "rendimiento": "node qa/e2e/rendimiento.js",
    "accesibilidad": "node qa/e2e/accesibilidad.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "playwright-core": "^1.56.1"
  }
}
