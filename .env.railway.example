# ============================================================================
#  VARIABLES PARA RAILWAY (base de datos y archivos en SUPABASE)
#  Railway → tu servicio → Variables → "Raw Editor" → pega esto con tus valores.
#  Guía completa: docs/12-primera-version-railway-supabase.md
#  ⚠ NO subas este archivo con valores reales al repositorio.
# ============================================================================

NODE_ENV=production
TZ=America/Santiago

# BASE DE DATOS — opción fácil: con estos dos datos el servidor encuentra solo el "Session pooler".
# (La contraseña puede tener símbolos como @; no hay que codificarla).
SUPABASE_DB_PASSWORD=LA_CLAVE_DE_LA_BASE
# Opción manual (en vez de la anterior): Supabase → Connect → Session pooler → URI (puerto 5432)
# DATABASE_URL=postgresql://postgres.TU_REF:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://TU_REF.supabase.co
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…)  o la antigua "service_role"
SUPABASE_SECRET_KEY=sb_secret_CAMBIAR
# Bucket privado para fotos y boletas (se crea solo en el primer arranque)
SUPABASE_BUCKET=envios-privado

# Cadena aleatoria de 64 caracteres: npm run secreto
JWT_SECRET=CAMBIAR_POR_UNA_CADENA_LARGA_ALEATORIA

# Administrador inicial (se crea en el primer arranque)
ADMIN_EMAIL=admin@tuempresa.cl
ADMIN_PASSWORD=CAMBIAR.Clave.Segura

# Primera versión: demo ABIERTA, se entra eligiendo un perfil (sin inicio de sesión).
# Para volver a protegerla con una clave, descomenta DEMO_CLAVE y ponle un valor.
AUTH_MODE=demo
# DEMO_CLAVE=
SEED_DEMO=true

# Opcionales
# PUBLIC_BASE_URL=https://envios.tuempresa.cl   (si no se define, usa el dominio de Railway)
# CORS_ORIGINS=https://tu-app.vercel.app        (solo si la interfaz se publica en Vercel)
