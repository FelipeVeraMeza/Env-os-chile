# Variables del SERVIDOR (copiar a .env). En Railway se definen en la pestaña Variables.
PORT=3000
NODE_ENV=development
TZ=America/Santiago

# Base de datos: local (docker compose) o Supabase (Session pooler, puerto 5432).
# Con Supabase el SSL se activa solo. Ver docs/12-primera-version-railway-supabase.md
DATABASE_URL=postgres://envios:envios@localhost:5432/envios
# Forzar SSL (true/false). Vacío = automático (activo para Supabase)
# DATABASE_SSL=
# DB_POOL_MAX=5

# URL pública: se usa en los QR. En Railway no hace falta (se toma de RAILWAY_PUBLIC_DOMAIN).
PUBLIC_BASE_URL=http://localhost:3000
# Orígenes permitidos para la interfaz (Vercel, dominio .cl), separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# demo = sin inicio de sesión (solo para mostrar el visual). jwt = inicio de sesión real (producción)
AUTH_MODE=demo
# Clave para entrar a la demo publicada (vacío = sin clave, solo para localhost)
DEMO_CLAVE=
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_DIAS=30

# Administrador inicial (se crea en el primer arranque)
ADMIN_EMAIL=admin@envios.local
ADMIN_PASSWORD=Cambiar.Esta.Clave.2026
# Crear perfiles de demostración (cliente y repartidores). Poner false en producción.
SEED_DEMO=true

# Fotos y boletas: si defines SUPABASE_URL y SUPABASE_SECRET_KEY se guardan en Supabase Storage (bucket privado).
# SUPABASE_URL=https://TU_REF.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_BUCKET=envios-privado
# Sin Supabase se guardan en disco (en Railway requiere un Volume montado, p. ej. /data/uploads)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# Horas que un envío puede seguir sin pagar antes de anularse solo (por defecto 24)
# ANULAR_SIN_PAGO_HORAS=24

# false si la interfaz se publica solo en Vercel
SERVE_WEB=true
